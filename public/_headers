# Content-hashed assets are cached long term.
/assets/index-*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/index-*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/GreatVibes-fd86ce7ba460.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/images/cinematic/ambient/envelope-isolated-e71f21f1b289.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/images/cinematic/ambient/scalloped-card-883012c28e99.webp
  Cache-Control: public, max-age=31536000, immutable

# Cache other images and audio for fast repeat mobile visits while allowing revalidation.
/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
